# Backend
OPENAI_API_KEY=sk-...
# Set to 0 to force the fully rule-based engine (great for demos offline)
WASTE2WORTH_USE_AI=1
WASTE2WORTH_OPENAI_MODEL=gpt-5-mini
WASTE2WORTH_VISION_MODEL=gpt-5-mini

# Outbound agent email (optional — without these the agent logs simulated contact)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password
SMTP_FROM=you@example.com

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Database (defaults to local SQLite if unset)
# DATABASE_URL=postgresql://user:pass@host:5432/waste2worth
